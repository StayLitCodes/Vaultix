# Database Configuration
# Supported drivers: sqlite, postgres
DATABASE_DRIVER=sqlite

# SQLite (Local Development)
DATABASE_PATH=./data/vaultix.db

# PostgreSQL (Production)
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/vaultix

# JWT Configuration (Required at startup, minimum 32 characters long)
JWT_SECRET=your-32-character-minimum-super-secret-key-here
JWT_EXPIRES_IN=15m

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
# CORS allowed origins (comma-separated). Use * to allow all origins (not recommended for production).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Health Check Configuration
# Max time (ms) each dependency probe may take before being reported as down
HEALTH_CHECK_TIMEOUT_MS=5000

# Request Logging Configuration
# Response time (ms) threshold for slow request warnings
REQUEST_LOG_SLOW_THRESHOLD_MS=5000

# Stellar Configuration
STELLAR_NETWORK=testnet
WALLET_SECRET="your-stellar-wallet-secret"
STELLAR_TIMEOUT=60000
STELLAR_MAX_RETRIES=3
STELLAR_RETRY_DELAY=1000

# Email (SMTP) Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@vaultix.io
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=60000

# Webhook Delivery Configuration
# Max delivery attempts before a webhook moves to the dead letter queue
WEBHOOK_MAX_ATTEMPTS=6
# Backoff schedule in ms (1m, 5m, 30m, 2h, 12h, 24h)
WEBHOOK_RETRY_SCHEDULE_MS=60000,300000,1800000,7200000,43200000,86400000
# Outbound request timeout in ms
WEBHOOK_REQUEST_TIMEOUT_MS=30000
# Alert when failure rate (%) in the window exceeds this threshold
WEBHOOK_ALERT_FAILURE_RATE_THRESHOLD=25
WEBHOOK_ALERT_MIN_DELIVERIES=10
WEBHOOK_ALERT_WINDOW_MINUTES=60
# Base URL used to build email verification links (defaults to API_BASE_URL + /auth/profile/verify-email)
API_BASE_URL=http://localhost:3000
#EMAIL_VERIFICATION_BASE_URL=https://app.vaultix.io/verify-email

# App Version Gating
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL=https://apps.apple.com/app/vaultix/id0000000000

# Database Backup Configuration
BACKUP_LOCAL_DIR=./data/backups
BACKUP_ENCRYPTION_KEY=your-encryption-key-min-32-chars
BACKUP_S3_BUCKET=your-s3-bucket-name
BACKUP_S3_PREFIX=vaultix/backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key
BACKUP_S3_ENDPOINT=
BACKUP_STORAGE_QUOTA_BYTES=10737418240
BACKUP_ALERT_THRESHOLD_PERCENT=80

# KYC Configuration
KYC_DEFAULT_PROVIDER=mock
KYC_REQUIRED_MIN_ESCROW_AMOUNT=1000
# KYC provider API keys (for production)
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# SUMSUB_API_KEY=
# SUMSUB_SECRET_KEY=

# AML Configuration
AML_PROVIDER=mock
# CHAINALYSIS_API_KEY=

# IPFS Configuration
IPFS_PROVIDER=pinata
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key
PINATA_JWT=your-pinata-jwt-token
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
IPFS_LOCAL_NODE_URL=http://localhost:5001
IPFS_MAX_RETRIES=1
