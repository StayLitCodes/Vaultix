<h1 style="margin: 0 0 8px 0; color: #ffffff; font-size: 24px; font-weight: 700;">Milestone released</h1>
<p style="margin: 0 0 24px 0; color: #94a3b8; font-size: 15px; line-height: 24px;">
  A milestone payment has been released for the escrow transaction below.
</p>

{{{escrowDetails}}}

{{#if milestoneName}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 20px 0; background-color: #1a2a2a; border-radius: 8px; border: 1px solid #204a4a;">
  <tr>
    <td style="padding: 16px 20px;">
      <span style="color: #67e8f9; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px;">Milestone</span><br>
      <span style="color: #22d3ee; font-size: 15px; font-weight: 600;">{{milestoneName}}</span>
    </td>
  </tr>
  {{#if milestoneAmount}}
  <tr>
    <td style="padding: 12px 20px; border-top: 1px solid #204a4a;">
      <span style="color: #67e8f9; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px;">Amount Released</span><br>
      <span style="color: #22d3ee; font-size: 18px; font-weight: 700;">{{milestoneAmount}} {{asset}}</span>
    </td>
  </tr>
  {{/if}}
</table>
{{/if}}

{{{buttonHtml}}}

<p style="margin: 0; color: #64748b; font-size: 13px; line-height: 20px;">
  The funds have been transferred to the designated recipient on the Stellar blockchain.
</p>
