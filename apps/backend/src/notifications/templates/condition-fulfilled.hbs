<h1 style="margin: 0 0 8px 0; color: #ffffff; font-size: 24px; font-weight: 700;">Condition fulfilled</h1>
<p style="margin: 0 0 24px 0; color: #94a3b8; font-size: 15px; line-height: 24px;">
  A condition has been fulfilled for the escrow transaction below.
</p>

{{{escrowDetails}}}

{{#if condition}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 20px 0; background-color: #1e2030; border-radius: 8px; border: 1px solid #2a2d42;">
  <tr>
    <td style="padding: 16px 20px;">
      <span style="color: #94a3b8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px;">Condition</span><br>
      <span style="color: #e2e8f0; font-size: 15px; font-weight: 600;">{{condition}}</span>
    </td>
  </tr>
</table>
{{/if}}

{{{buttonHtml}}}

<p style="margin: 0; color: #64748b; font-size: 13px; line-height: 20px;">
  The condition now requires confirmation before the escrow can proceed.
</p>
