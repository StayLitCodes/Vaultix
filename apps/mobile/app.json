{
  "expo": {
    "name": "Vaultix",
    "slug": "vaultix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vaultix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.vaultix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "io.vaultix.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vaultix to access your camera to scan Stellar addresses and escrow IDs.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
