# Environment selector
# One of: dev | testnet | production
# Controls which defaults from security/env.ts are used when vars below are unset.
EXPO_PUBLIC_APP_ENV=dev

# Backend API base URL
# Dev default (if unset):      http://localhost:3000
# Testnet default (if unset):  https://api-testnet.vaultix.com
# Production default (if unset): https://api.vaultix.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stellar Soroban RPC endpoint
# Dev default (if unset):      http://localhost:8000/soroban/rpc  (standalone soroban-rpc)
# Testnet default (if unset):  https://soroban-testnet.stellar.org
# Production default (if unset): https://rpc.vaultix.com
EXPO_PUBLIC_RPC_URL=http://localhost:8000/soroban/rpc

# Optional overrides

# Auth route prefix (only override if behind a custom gateway)
# EXPO_PUBLIC_AUTH_PATH_PREFIX=/v1/auth
