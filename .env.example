# Local-only Docker Compose defaults. Replace credentials before sharing/deploying.
POSTGRES_DB=vaultix_db
POSTGRES_USER=vaultix_user
POSTGRES_PASSWORD=vaultix_pass
JWT_SECRET=local-compose-secret-change-this-before-use-0123456789

# Optional override. If unset, Compose builds the URL from the Postgres values above.
# URL-encode special characters in the password when setting DATABASE_URL.
# DATABASE_URL=postgresql://vaultix_user:vaultix_pass@db:5432/vaultix_db

# Browser-visible values are embedded in the frontend image during its build.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Host ports
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001